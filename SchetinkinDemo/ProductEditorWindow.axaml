<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="750"
        x:CompileBindings="False"
        x:Class="SchetinkinDemo.ProductEditorWindow"
        Title="Редактор товара"
        WindowStartupLocation="CenterOwner">
  <StackPanel Spacing="10" Margin="20">
    <TextBlock Text="Название:"/>
    <TextBox Name="NameTextBox"/>
    
    <TextBlock Text="Артикул (SKU):"/>
    <TextBox Name="SkuTextBox"/>
    
    <TextBlock Text="Цена:"/>
    <TextBox Name="PriceTextBox"/>
    
    <TextBlock Text="Остаток:"/>
    <TextBox Name="StockTextBox"/>

   <TextBlock Text="Брэнд:"/>
    <ComboBox Name="BrandComboBox" DisplayMemberBinding="{Binding Name}" />

    <TextBlock Text="Категория:"/>
    <ComboBox Name="CategoryComboBox" DisplayMemberBinding="{Binding Name}" />

      <CheckBox Name="ActiveCheckBox" Content="Товар активен" Margin="5" IsChecked="True"/>

    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Name="SaveButton" Content="Сохранить" Click="SaveButton_Click"/>
      <Button Name="CancelButton" Content="Отменить" Click="CancelButton_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
