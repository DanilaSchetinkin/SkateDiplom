<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchetinkinDemo.ClientCatalogView"
             x:CompileBindings="False">
  <DockPanel Margin="10">
    <!-- Панель фильтров и сортировки -->
    <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Категория:" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" Name="CategoryComboBox" Margin="5,0" 
                  HorizontalAlignment="Stretch" 
                  SelectionChanged="CategoryComboBox_SelectionChanged"/>
        <TextBox Grid.Column="2" Name="SearchTextBox" Watermark="Поиск по названию..." Width="200" Margin="5,0"/>
        <Button Grid.Column="3" Name="SearchButton" Content="Поиск" Click="SearchButton_Click"/>
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Сортировка:" VerticalAlignment="Center"/>
        <ComboBox Grid.Column="1" Name="SortComboBox" Margin="5,0" 
                  HorizontalAlignment="Stretch" 
                  SelectionChanged="SortComboBox_SelectionChanged">
          <ComboBoxItem Tag="NameAsc">По названию (А-Я)</ComboBoxItem>
          <ComboBoxItem Tag="NameDesc">По названию (Я-А)</ComboBoxItem>
          <ComboBoxItem Tag="PriceAsc">По цене (возрастание)</ComboBoxItem>
          <ComboBoxItem Tag="PriceDesc">По цене (убывание)</ComboBoxItem>
        </ComboBox>
      </Grid>
    </StackPanel>

    <!-- Список товаров -->
    <ListBox Name="ProductsListBox" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <!-- Изображение -->
              <Image Grid.Column="0" Source="{Binding ImagePath}" Width="80" Height="80" 
                     Stretch="Uniform" Margin="0,0,10,0"/>
              <!-- Информация о товаре -->
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Name}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{Binding Sku, StringFormat='Артикул: {0}'}" />
                  <TextBlock Text="{Binding BrandName, StringFormat='Бренд: {0}'}" Foreground="Gray"/>
                  <TextBlock Text="{Binding CategoryName, StringFormat='Категория: {0}'}" Foreground="Gray"/>
                </StackPanel>
                <TextBlock Text="{Binding StockQuantity, StringFormat='Остаток: {0} шт.'}" Foreground="Gray"/>
              </StackPanel>
              <!-- Цена и кнопка -->
              <StackPanel Grid.Column="2" Spacing="5" HorizontalAlignment="Right">
                <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Price, StringFormat='{}{0:c}'}" 
                           Foreground="Green"/>
                <Button Content="В корзину" Click="AddToCartButton_Click" 
                        Tag="{Binding Id}" Padding="10,5"/>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
