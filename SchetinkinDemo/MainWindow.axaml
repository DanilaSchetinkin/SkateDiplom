<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SchetinkinDemo.MainWindow"
        Title="Скейтшоп"
        Width="420" Height="520"
        WindowStartupLocation="CenterScreen"
        Background="#23262F"
        CanResize="False">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Шапка -->
    <Border Grid.Row="0" Background="#1A1A2E" Padding="0,32,0,24">
      <StackPanel HorizontalAlignment="Center" Spacing="4">
        <TextBlock Text="🛹" FontSize="36" HorizontalAlignment="Center"/>
        <TextBlock Text="СКЕЙТШОП" FontSize="22" FontWeight="Bold"
                   Foreground="White" HorizontalAlignment="Center" LetterSpacing="3"/>
        <TextBlock Text="Войдите в аккаунт" FontSize="13" Foreground="#A0A8C0"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Форма -->
    <Border Grid.Row="1" Background="#2C2F3A" Margin="32,0" Padding="32,28"
            CornerRadius="0,0,12,12"
            BoxShadow="0 4 24 0 #1A000000">
      <StackPanel Spacing="16">

        <StackPanel Spacing="6">
          <TextBlock Text="Логин" FontSize="13" Foreground="#B0B4C8" FontWeight="SemiBold"/>
          <TextBox x:Name="LoginBox"
                   Padding="12,10"
                   CornerRadius="8"
                   BorderBrush="#3A3F52"
                   Background="#1E2029"
                   Watermark="Введите логин"/>
        </StackPanel>

        <StackPanel Spacing="6">
          <TextBlock Text="Пароль" FontSize="13" Foreground="#B0B4C8" FontWeight="SemiBold"/>
          <TextBox x:Name="PasswordBox"
                   PasswordChar="●"
                   Padding="12,10"
                   CornerRadius="8"
                   BorderBrush="#3A3F52"
                   Background="#1E2029"
                   Watermark="Введите пароль"/>
        </StackPanel>

        <TextBlock Name="ErrorMessageTextBlock"
                   Foreground="#E53935"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   TextWrapping="Wrap"/>

        <Button Name="LoginButton"
                Content="Войти"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="0,12"
                CornerRadius="8"
                Background="#1A1A2E"
                Foreground="White"
                FontSize="15"
                FontWeight="SemiBold"
                Click="Button_Click"/>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Height="32"/>
  </Grid>
</Window>

