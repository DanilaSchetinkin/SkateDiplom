<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SchetinkinDemo.UsersView"
             Loaded="UsersView_Loaded"
             x:CompileBindings="False">

  <DockPanel>

    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Пользователи" FontSize="22" FontWeight="Bold" Foreground="#E8EAF0"/>
    </Border>

    <ListBox Name="UsersListBox"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="#2C2F3A" CornerRadius="10" Padding="16" Margin="0,0,0,8"
                  BoxShadow="0 2 8 0 #0A000000">
            <Grid ColumnDefinitions="*,Auto" MinWidth="600">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock FontWeight="Bold" FontSize="15"
                           Text="{Binding FullName}" Foreground="#E8EAF0"/>
                <TextBlock Text="{Binding Email}" Foreground="#9096B0" FontSize="13"/>
              </StackPanel>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding AllRoles}"
                        SelectedItem="{Binding UserRole, Mode=OneWay}"
                        DisplayMemberBinding="{Binding Name}"
                        SelectionChanged="RoleComboBox_SelectionChanged"
                        Width="160" Padding="10,8" CornerRadius="8"
                        BorderBrush="#3A3F52"
                        VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>

