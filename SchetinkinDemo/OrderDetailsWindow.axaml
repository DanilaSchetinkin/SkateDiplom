<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        x:CompileBindings="False"
        x:Class="SchetinkinDemo.OrderDetailsWindow"
        Title="Детали заказа"
        Background="#23262F">

  <Border Background="#2C2F3A" Margin="20" CornerRadius="12"
          BoxShadow="0 4 24 0 #1A000000" Padding="28">
    <DockPanel>

      <!-- Кнопка закрыть -->
      <Button Name="CloseButton" DockPanel.Dock="Bottom"
              Content="Закрыть"
              HorizontalAlignment="Right" Margin="0,20,0,0"
              Padding="18,10" CornerRadius="8"
              Background="#1A1A2E" Foreground="White"
              FontWeight="SemiBold"
              Click="CloseButton_Click" IsCancel="True"/>

      <!-- Шапка заказа -->
      <Border DockPanel.Dock="Top" Margin="0,0,0,16"
              Background="#23262F" CornerRadius="8" Padding="16">
        <StackPanel Spacing="6">
          <TextBlock Name="OrderNumberTextBlock" FontSize="18"
                     FontWeight="Bold" Foreground="#E8EAF0"/>
          <TextBlock Name="CustomerNameTextBlock" Foreground="#B0B4C8" FontSize="13"/>
          <TextBlock Name="OrderDateTextBlock" Foreground="#7078A0" FontSize="12"/>
          <Border Background="#1E3020" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
            <TextBlock Name="StatusTextBlock" FontWeight="Bold"
                       Foreground="#66BB6A" FontSize="13"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- Список позиций -->
      <ListBox Name="OrderItemsListBox"
               Background="Transparent" BorderThickness="0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="8,10">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                           Foreground="#E8EAF0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Quantity, StringFormat='{}{0} шт.'}"
                           Margin="16,0" Foreground="#B0B4C8" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding PricePerUnit, StringFormat='{}{0:c}'}"
                           Margin="8,0" Foreground="#7078A0" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding TotalPositionAmount, StringFormat='{}{0:c}'}"
                           FontWeight="Bold" Margin="8,0"
                           Foreground="#66BB6A" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </DockPanel>
  </Border>
</Window>

