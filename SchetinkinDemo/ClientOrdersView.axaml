<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SchetinkinDemo.ClientOrdersView"
             x:CompileBindings="False">
  <DockPanel Margin="10">
    <ListBox Name="OrdersListBox">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="5">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="5">
                <TextBlock FontWeight="Bold" Text="{Binding OrderNumber}"/>
                <TextBlock Text="{Binding CreatedAt, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}" Foreground="Gray"/>
                <TextBlock Text="{Binding Status, StringFormat='Статус: {0}'}" Foreground="DarkGreen"/>
              </StackPanel>
              <Button Grid.Column="1" Content="Детали" Click="ViewDetails_Click" Tag="{Binding Id}" Padding="10,5"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>