<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SchetinkinDemo.ClientOrdersView"
             x:CompileBindings="False">

  <DockPanel>

    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Мои заказы" FontSize="22" FontWeight="Bold" Foreground="#E8EAF0"/>
    </Border>

    <ListBox Name="OrdersListBox"
             Background="Transparent" BorderThickness="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="#2C2F3A" CornerRadius="10" Padding="16" Margin="0,0,0,8"
                  BoxShadow="0 2 8 0 #0A000000">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock FontWeight="Bold" FontSize="15"
                           Text="{Binding OrderNumber}" Foreground="#E8EAF0"/>
                <TextBlock Text="{Binding CreatedAt, StringFormat='Дата: {0:dd.MM.yyyy HH:mm}'}"
                           Foreground="#7078A0" FontSize="12"/>
                <Border Background="#1E3020" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding Status}" FontSize="12"
                             Foreground="#66BB6A" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Content="Подробнее →"
                      Click="ViewDetails_Click" Tag="{Binding Id}"
                      Padding="14,8" CornerRadius="8"
                      Background="#1A1A2E" Foreground="White"
                      VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>

