<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="SchetinkinDemo.OrderView"
             x:CompileBindings="False"
             Loaded="OrderView_Loaded">

  <DockPanel>

    <Border DockPanel.Dock="Top" Margin="0,0,0,16">
      <TextBlock Text="Заказы" FontSize="22" FontWeight="Bold" Foreground="#E8EAF0"/>
    </Border>

    <ListBox Name="OrdersListBox"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Background="Transparent" BorderThickness="0"
             DoubleTapped="OrdersListBox_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Background="#2C2F3A" CornerRadius="10" Padding="16" Margin="0,0,0,8"
                  BoxShadow="0 2 8 0 #0A000000">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                <TextBlock FontWeight="Bold" FontSize="15"
                           Text="{Binding OrderNumber}" Foreground="#E8EAF0"/>
                <TextBlock Text="{Binding CustomerName}" Foreground="#B0B4C8" FontSize="13"/>
                <TextBlock Text="{Binding OrderDate}" Foreground="#7078A0" FontSize="12"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16"
                          VerticalAlignment="Center">
                <TextBlock FontSize="18" FontWeight="Bold"
                           Text="{Binding TotalAmount, StringFormat='{}{0:c}'}"
                           Foreground="#66BB6A" VerticalAlignment="Center"/>
                <ComboBox SelectedItem="{Binding Status}"
                          SelectionChanged="StatusComboBox_SelectionChanged"
                          Width="160" Padding="10,8" CornerRadius="8"
                          BorderBrush="#3A3F52">
                  <ComboBoxItem Content="Новый"/>
                  <ComboBoxItem Content="В процессе"/>
                  <ComboBoxItem Content="Оправлен"/>
                  <ComboBoxItem Content="Доставлен"/>
                  <ComboBoxItem Content="Отменён"/>
                </ComboBox>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

  </DockPanel>
</UserControl>

