<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="SchetinkinDemo.ClientWindow"
        Title="Скейтшоп"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#23262F">

  <Grid ColumnDefinitions="220,*">

    <!-- Боковая панель -->
    <Border Grid.Column="0" Background="#1A1A2E">
      <DockPanel>

        <!-- Профиль -->
        <Border DockPanel.Dock="Top" Padding="16,28,16,20"
                BorderBrush="#2D2D4E" BorderThickness="0,0,0,1">
          <StackPanel Spacing="4">
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="#2D2D4E" HorizontalAlignment="Left">
              <TextBlock Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Name="FioTextBlock" FontWeight="Bold" Foreground="White"
                       FontSize="14" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <!-- Кнопка выхода внизу -->
        <Border DockPanel.Dock="Bottom" Padding="12,12">
          <Button Name="LogoutButton" Content="⬅  Выйти"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="12,10"
                  CornerRadius="8"
                  Background="#C62828"
                  Foreground="White"
                  FontWeight="SemiBold"
                  Click="LogoutButton_Click"/>
        </Border>

        <!-- Навигация -->
        <StackPanel Margin="12,16,12,0" Spacing="4">
          <Button Name="CatalogButton" Content="🛹  Каталог"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="12,10" CornerRadius="8"
                  Background="Transparent" Foreground="#C8CCDE"
                  FontSize="14"
                  Click="CatalogButton_Click"/>
          <Button Name="CartButton" Content="🛒  Корзина"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="12,10" CornerRadius="8"
                  Background="Transparent" Foreground="#C8CCDE"
                  FontSize="14"
                  Click="CartButton_Click"/>
          <Button Name="OrdersButton" Content="📦  Мои заказы"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="12,10" CornerRadius="8"
                  Background="Transparent" Foreground="#C8CCDE"
                  FontSize="14"
                  Click="OrdersButton_Click"/>
          <Button Name="SupportChatButton" Content="💬  Поддержка"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Padding="12,10" CornerRadius="8"
                  Background="Transparent" Foreground="#C8CCDE"
                  FontSize="14"
                  Click="SupportChatButton_Click"/>
        </StackPanel>

      </DockPanel>
    </Border>

    <!-- Контент -->
    <Border Grid.Column="1" Background="#23262F">
      <ContentControl Name="MainContentControl" Margin="24"/>
    </Border>

  </Grid>
</Window>

