<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SchetinkinDemo.ClientWindow"
        Title="Клиентская панель"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#808080">
  <Grid ColumnDefinitions="200, *">
    <!-- Левая панель навигации -->
    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
      <StackPanel Spacing="10" Margin="10">
        <Border Padding="10" CornerRadius="5">
          <StackPanel Spacing="5">
            <TextBlock Name="FioTextBlock" FontWeight="Bold" Text="Имя Фамилия"/>
            <Button Name="LogoutButton" Content="Выйти" Background="Red" Click="LogoutButton_Click" HorizontalAlignment="Stretch" Margin="0,10,0,0"/>
          </StackPanel>
        </Border>

        <Button Name="CatalogButton" Content="Каталог" Click="CatalogButton_Click" HorizontalAlignment="Stretch"/>
        <Button Name="CartButton" Content="Корзина" Click="CartButton_Click" HorizontalAlignment="Stretch"/>
        <Button Name="OrdersButton" Content="Мои заказы" Click="OrdersButton_Click" HorizontalAlignment="Stretch"/>
      </StackPanel>
    </Border>

    <ContentControl Grid.Column="1" Name="MainContentControl" Margin="15"/>
  </Grid>
</Window>